{
  "name": "@rivedian/oxlint-config",
  "version": "0.1.0",
  "description": "Strict, type-aware shared oxlint configuration for TypeScript",
  "keywords": [
    "code-quality",
    "eslint",
    "linter",
    "oxc",
    "oxlint",
    "oxlint-config",
    "typescript"
  ],
  "bugs": "https://github.com/rivedian/oxc-kit/issues",
  "license": "MIT",
  "author": {
    "name": "Oleg Michailov",
    "email": "oleg.michailov@rivedian.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivedian/oxc-kit.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "run-p -c lint format:check",
    "prepublishOnly": "run-s build verify"
  },
  "peerDependencies": {
    "oxlint": ">=1.85.0",
    "oxlint-tsgolint": ">=7.0.2003"
  }
}
