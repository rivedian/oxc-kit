{
  "name": "@rivedian/oxlint-config",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write"
  },
  "peerDependencies": {
    "oxlint": ">=1.85.0",
    "oxlint-tsgolint": ">=7.0.2003"
  }
}
