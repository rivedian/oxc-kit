{
  "name": "@rivedian/oxfmt-config",
  "version": "0.0.0",
  "description": "Opinionated shared oxfmt configuration with import sorting",
  "keywords": [
    "code-style",
    "formatter",
    "oxc",
    "oxfmt",
    "oxfmt-config",
    "prettier",
    "sort-imports"
  ],
  "bugs": "https://github.com/rivedian/oxc-kit/issues",
  "license": "MIT",
  "author": {
    "name": "Oleg Michailov",
    "email": "oleg.michailov@rivedian.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivedian/oxc-kit.git",
    "directory": "packages/oxfmt-config"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "run-p -c lint format:check",
    "prepublishOnly": "run-s build verify"
  },
  "peerDependencies": {
    "oxfmt": ">=0.70.0"
  }
}
